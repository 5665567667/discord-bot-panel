# Discord Developer Portal credentials. Keep this file private.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:8787/auth/callback

# Generate 32 random bytes and write them as 64 hexadecimal characters.
APP_ENCRYPTION_KEY=

# Local-only defaults. Do not bind to 0.0.0.0 unless you configure a trusted HTTPS proxy.
BIND_ADDR=127.0.0.1:8787
DATABASE_URL=sqlite://data/panel.db?mode=rwc
COOKIE_SECURE=false
